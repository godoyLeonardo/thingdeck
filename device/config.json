{
  "_help": "Any action can carry per-OS overrides: {\"key\": \"win+tab\", \"mac\": {\"key\": \"ctrl+up\"}, \"linux\": {\"key\": \"win\"}}. Linux overrides assume GNOME. See device/README.md.",
  "kiosk": true,
  "grid": [4, 2],
  "layout": "latam",
  "default_os": "windows",
  "other_os": "linux",
  "icon_style": "solid",
  "icon_color": "neutral",

  "hardware": {
    "dial_invert": false,
    "knob": { "tap": { "dial_press": true }, "hold": { "media": "play_pause" } },
    "back": { "tap": { "page": "next" }, "hold": { "page": 0 } },
    "menu": { "tap": { "dial": "next" }, "hold": { "dial": "Volume" } }
  },

  "dial_modes": [
    { "name": "Volume", "cw": { "media": "vol_up" }, "ccw": { "media": "vol_down" }, "press": { "media": "mute" } },
    { "name": "Lights", "cw": { "hue": "up" }, "ccw": { "hue": "down" }, "press": { "hue": "toggle" } },
    { "name": "Scroll", "cw": { "wheel": -1 }, "ccw": { "wheel": 1 }, "press": { "click": "middle" } },
    { "name": "Zoom",
      "cw": { "wheel": 1, "mods": "ctrl", "mac": { "key": "cmd+equal" } },
      "ccw": { "wheel": -1, "mods": "ctrl", "mac": { "key": "cmd+minus" } },
      "press": { "key": "ctrl+0", "mac": { "key": "cmd+0" } } },
    { "name": "Scrub", "cw": { "key": "right" }, "ccw": { "key": "left" }, "press": { "key": "space" } },
    { "name": "Tabs", "cw": { "key": "ctrl+tab" }, "ccw": { "key": "ctrl+shift+tab" },
      "press": { "key": "ctrl+shift+t", "mac": { "key": "cmd+shift+t" } } },
    { "name": "Undo / Redo",
      "cw": { "key": "ctrl+y", "mac": { "key": "cmd+shift+z" }, "linux": { "key": "ctrl+shift+z" } },
      "ccw": { "key": "ctrl+z", "mac": { "key": "cmd+z" } },
      "press": { "key": "ctrl+s", "mac": { "key": "cmd+s" } } }
  ],

  "presets": [
    { "label": "Prev", "media": "prev" },
    { "label": "Play/Pause", "media": "play_pause" },
    { "label": "Next", "media": "next" },
    { "label": "Mute", "media": "mute" }
  ],

  "pages": [
    {
      "name": "Media",
      "nowplaying": true,
      "header": "clock",
      "audio": true,
      "tiles": [
        { "label": "Stop", "symbol": "stop", "media": "stop" },
        { "label": "Previous", "symbol": "prev", "media": "prev" },
        { "label": "Play / Pause", "symbol": "play", "media": "play_pause", "wide": true },
        { "label": "Next", "symbol": "next", "media": "next" },
        { "label": "Mute", "symbol": "mute", "media": "mute" }
      ]
    },
    {
      "_note": "Philips Hue rooms and zones, through the computer agent (pair from this page).",
      "name": "Lights",
      "header": "clock",
      "widgets": ["lights"]
    },
    {
      "_note": "Upcoming events from calendars.txt on the computer (needs the computer agent).",
      "name": "Calendar",
      "header": "clock",
      "widgets": ["agenda"]
    },
    {
      "_note": "CPU, memory, GPU and network of the computer, and a kill switch for the focused app (needs the computer agent).",
      "name": "Status",
      "header": "clock",
      "widgets": ["monitor"],
      "kill": true
    },
    {
      "_note": "Latest workflow runs of the repo in github.txt on the computer, and your open pull requests (needs the computer agent and gh).",
      "name": "Code",
      "header": "clock",
      "widgets": ["github"]
    },
    {
      "_note": "Streams, load, bandwidth and libraries of the Plex server in plex.txt on the computer (needs the computer agent).",
      "name": "Plex",
      "header": "clock",
      "widgets": ["plex"]
    },
    {
      "name": "Desktop",
      "presets": [
        { "label": "◀ Desktop", "key": "ctrl+win+left", "mac": { "key": "ctrl+left" }, "linux": { "key": "win+pageup" } },
        { "label": "Task view", "key": "win+tab", "mac": { "label": "Mission Control", "key": "ctrl+up" },
          "linux": { "label": "Overview", "key": "win" } },
        { "label": "Desktop ▶", "key": "ctrl+win+right", "mac": { "key": "ctrl+right" }, "linux": { "key": "win+pagedown" } },
        { "label": "Show desktop", "key": "win+d", "mac": { "key": "f11" } }
      ],
      "tiles": [
        { "label": "Task view", "symbol": "windows", "key": "win+tab", "mac": { "label": "Mission Control", "key": "ctrl+up" },
          "linux": { "label": "Overview", "key": "win" } },
        { "label": "Show desktop", "symbol": "desktop", "key": "win+d", "mac": { "key": "f11" } },
        { "label": "Snip", "symbol": "snip", "key": "win+shift+s", "mac": { "key": "cmd+shift+4" }, "linux": { "key": "printscreen" } },
        { "label": "Clipboard", "symbol": "clipboard", "key": "win+v", "mac": { "label": "Spotlight", "symbol": "search", "key": "cmd+space" } },
        { "label": "Files", "symbol": "folder", "key": "win+e", "mac": { "label": "Finder", "key": "cmd+option+space" },
          "linux": { "seq": [{ "key": "win" }, { "type": "files\n" }], "delay": 0.5, "hint": "Super → files" } },
        { "label": "Emoji", "symbol": "smile", "key": "win+.", "mac": { "key": "ctrl+cmd+space" }, "linux": { "key": "ctrl+." } },
        { "label": "Task Manager", "symbol": "activity", "key": "ctrl+shift+esc",
          "mac": { "label": "Activity Monitor", "seq": [{ "key": "cmd+space" }, { "type": "activity monitor\n" }], "delay": 0.5, "hint": "Spotlight → Activity Monitor" },
          "linux": { "label": "System Monitor", "seq": [{ "key": "win" }, { "type": "system monitor\n" }], "delay": 0.5, "hint": "Super → system monitor" } },
        { "label": "Lock", "symbol": "lock", "key": "win+l", "mac": { "key": "ctrl+cmd+q" } }
      ]
    },
    {
      "name": "Shell",
      "presets": [
        { "label": "Ctrl+C", "key": "ctrl+c" },
        { "label": "Rerun last", "seq": [{ "key": "up" }, { "key": "enter" }] },
        { "label": "Clear", "type": "clear\n" },
        { "label": "git status", "type": "git status\n" }
      ],
      "tiles": [
        { "label": "git status", "symbol": "branch", "type": "git status\n" },
        { "label": "git pull", "symbol": "download", "type": "git pull\n" },
        { "label": "git diff", "symbol": "diff", "type": "git diff\n" },
        { "label": "git log", "symbol": "list", "type": "git log --oneline -15\n" },
        { "label": "npm test", "symbol": "flask", "type": "npm test\n" },
        { "label": "npm run dev", "symbol": "launch", "type": "npm run dev\n" },
        { "label": "Rerun last", "symbol": "repeat", "seq": [{ "key": "up" }, { "key": "enter" }] },
        { "label": "Interrupt", "symbol": "interrupt", "key": "ctrl+c" }
      ]
    },
    {
      "_note": "A page slot with choices: Settings → General → Pages picks one; Auto uses \"default\" for the host OS.",
      "id": "calls",
      "label": "Calls page",
      "default": { "windows": "Discord", "other": "Meetings" },
      "choices": [
        {
          "name": "Meetings",
          "presets": [
            { "label": "Teams mic", "key": "ctrl+shift+m", "mac": { "key": "cmd+shift+m" } },
            { "label": "Teams cam", "key": "ctrl+shift+o", "mac": { "key": "cmd+shift+o" } },
            { "label": "Zoom mic", "key": "alt+a", "mac": { "key": "cmd+shift+a" } },
            { "label": "Zoom cam", "key": "alt+v", "mac": { "key": "cmd+shift+v" } }
          ],
          "tiles": [
            { "label": "Teams mic", "symbol": "mic", "key": "ctrl+shift+m", "mac": { "key": "cmd+shift+m" } },
            { "label": "Teams camera", "symbol": "camera", "key": "ctrl+shift+o", "mac": { "key": "cmd+shift+o" } },
            { "label": "Teams hand", "symbol": "hand", "key": "ctrl+shift+k", "mac": { "key": "cmd+shift+k" } },
            { "label": "Teams leave", "symbol": "hangup", "key": "ctrl+shift+h", "mac": { "key": "cmd+shift+h" }, "color": "#ff5d5d" },
            { "label": "Zoom mic", "symbol": "mic", "key": "alt+a", "mac": { "key": "cmd+shift+a" } },
            { "label": "Zoom camera", "symbol": "camera", "key": "alt+v", "mac": { "key": "cmd+shift+v" } },
            { "label": "Meet mic", "symbol": "mic", "key": "ctrl+d", "mac": { "key": "cmd+d" } },
            { "label": "Meet camera", "symbol": "camera", "key": "ctrl+e", "mac": { "key": "cmd+e" } }
          ]
        },
        {
          "_note": "Discord's default shortcuts. Mute and deafen are global keybinds; the others need Discord in focus.",
          "name": "Discord",
          "presets": [
            { "label": "Mute", "key": "ctrl+shift+m", "mac": { "key": "cmd+shift+m" } },
            { "label": "Deafen", "key": "ctrl+shift+d", "mac": { "key": "cmd+shift+d" } },
            { "label": "Answer call", "key": "ctrl+enter", "mac": { "key": "cmd+enter" } },
            { "label": "Decline call", "key": "esc" }
          ],
          "tiles": [
            { "label": "Mute", "symbol": "mic", "key": "ctrl+shift+m", "mac": { "key": "cmd+shift+m" } },
            { "label": "Deafen", "symbol": "headphones", "key": "ctrl+shift+d", "mac": { "key": "cmd+shift+d" } },
            { "label": "Answer call", "symbol": "phone", "key": "ctrl+enter", "mac": { "key": "cmd+enter" } },
            { "label": "Decline call", "symbol": "hangup", "key": "esc", "color": "#ed4245" },
            { "label": "Quick switcher", "symbol": "search", "key": "ctrl+k", "mac": { "key": "cmd+k" } },
            { "label": "Back to voice", "symbol": "speaker", "key": "ctrl+alt+a", "mac": { "key": "cmd+option+a" } },
            { "label": "Inbox", "symbol": "inbox", "key": "ctrl+i", "mac": { "key": "cmd+i" } },
            { "label": "Mark server read", "symbol": "check", "key": "shift+esc" }
          ]
        }
      ]
    }
  ]
}
