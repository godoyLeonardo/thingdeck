{
  "_help": "Any action can carry per-OS overrides: {\"key\": \"win+tab\", \"mac\": {\"key\": \"ctrl+up\"}, \"linux\": {\"key\": \"win\"}}. Linux overrides assume GNOME. See device/README.md.",
  "kiosk": true,
  "grid": [4, 2],
  "layout": "latam",
  "default_os": "windows",
  "other_os": "linux",
  "icon_style": "solid",
  "icon_color": "neutral",

  "hardware": {
    "dial_invert": false,
    "knob": { "tap": { "dial_press": true }, "hold": { "media": "play_pause" } },
    "back": { "tap": { "page": "next" }, "hold": { "page": 0 } },
    "menu": { "tap": { "dial": "next" }, "hold": { "dial": "Volume" } }
  },

  "dial_modes": [
    { "_note": "On Windows the knob moves the dial from All to each app making sound (App volume); elsewhere it mutes.",
      "name": "Volume", "cw": { "mixer": "up" }, "ccw": { "mixer": "down" }, "press": { "mixer": "next" } },
    { "name": "Lights", "cw": { "hue": "up" }, "ccw": { "hue": "down" }, "press": { "hue": "toggle" } },
    { "name": "Scroll", "cw": { "wheel": -1 }, "ccw": { "wheel": 1 }, "press": { "click": "middle" } },
    { "name": "Zoom",
      "cw": { "wheel": 1, "mods": "ctrl", "mac": { "key": "cmd+equal" } },
      "ccw": { "wheel": -1, "mods": "ctrl", "mac": { "key": "cmd+minus" } },
      "press": { "key": "ctrl+0", "mac": { "key": "cmd+0" } } },
    { "name": "Scrub", "cw": { "key": "right" }, "ccw": { "key": "left" }, "press": { "key": "space" } },
    { "name": "Tabs", "cw": { "key": "ctrl+tab" }, "ccw": { "key": "ctrl+shift+tab" },
      "press": { "key": "ctrl+shift+t", "mac": { "key": "cmd+shift+t" } } },
    { "name": "Undo / Redo",
      "cw": { "key": "ctrl+y", "mac": { "key": "cmd+shift+z" }, "linux": { "key": "ctrl+shift+z" } },
      "ccw": { "key": "ctrl+z", "mac": { "key": "cmd+z" } },
      "press": { "key": "ctrl+s", "mac": { "key": "cmd+s" } } }
  ],

  "presets": [
    { "label": "First", "page": 0 },
    { "label": "Left", "page": "prev", "hold": { "label": "Previous track", "media": "prev" } },
    { "label": "Right", "page": "next", "hold": { "label": "Next track", "media": "next" } },
    { "label": "Last", "page": -1 }
  ],

  "pages": [
    {
      "name": "Media",
      "nowplaying": true,
      "header": "clock",
      "audio": true,
      "tiles": [
        { "label": "Stop", "symbol": "stop", "media": "stop" },
        { "label": "Previous", "symbol": "prev", "media": "prev" },
        { "label": "Play / Pause", "symbol": "play", "media": "play_pause", "wide": true },
        { "label": "Next", "symbol": "next", "media": "next" },
        { "label": "Mute", "symbol": "mute", "media": "mute" }
      ]
    },
    {
      "_note": "Philips Hue rooms and zones, through the computer agent (pair from this page).",
      "name": "Lights",
      "header": "clock",
      "widgets": ["lights"]
    },
    {
      "_note": "Upcoming events from calendars.txt on the computer (needs the computer agent).",
      "name": "Calendar",
      "header": "clock",
      "widgets": ["agenda"]
    },
    {
      "_note": "CPU, memory, GPU and network of the computer, and a kill switch for the focused app (needs the computer agent).",
      "name": "Status",
      "header": "clock",
      "widgets": ["monitor"],
      "kill": true
    },
    {
      "_note": "Latest workflow runs of the repo in github.txt on the computer, and your open pull requests (needs the computer agent and gh).",
      "name": "Code",
      "header": "clock",
      "widgets": ["github"]
    },
    {
      "_note": "Streams, load, bandwidth and libraries of the Plex server in plex.txt on the computer (needs the computer agent).",
      "name": "Plex",
      "header": "clock",
      "widgets": ["plex"]
    },
    {
      "_note": "Pools, disk temperatures, alerts and apps of the TrueNAS server in truenas.txt on the computer (needs the computer agent).",
      "name": "NAS",
      "header": "clock",
      "widgets": ["truenas"]
    }
  ]
}
